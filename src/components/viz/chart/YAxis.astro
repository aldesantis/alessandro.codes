---
import type { PlotArea, Scale } from "src/lib/viz/chart";

// Horizontal gridlines with tick labels on the left. The first tick is drawn
// as the baseline. Hidden from screen readers, like `XAxis`: the chart's label
// and its marks carry the values.
interface Props {
  plot: PlotArea;
  y: Scale;
  ticks: number[];
  format?: (value: number) => string;
}

const { plot, y, ticks, format = String } = Astro.props;
---

<g aria-hidden="true">
  {ticks.map((tick, index) => (
    <g>
      <line
        x1={plot.left}
        x2={plot.right}
        y1={y(tick)}
        y2={y(tick)}
        stroke={index === 0 ? "var(--viz-axis)" : "var(--viz-grid)"}
      />
      <text x={plot.left - 8} y={y(tick) + 4} text-anchor="end" class="viz-tick">
        {format(tick)}
      </text>
    </g>
  ))}
</g>
