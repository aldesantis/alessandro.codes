---
// The SVG shell for a chart. `label` is what screen readers announce, so it
// should state the takeaway, not just the chart type.
interface Props {
  width: number;
  height: number;
  label: string;
  class?: string;
}

const { width, height, label, class: className = "w-full" } = Astro.props;
---

<svg viewBox={`0 0 ${width} ${height}`} class:list={["h-auto", className]} role="img" aria-label={label}>
  <slot />
</svg>
