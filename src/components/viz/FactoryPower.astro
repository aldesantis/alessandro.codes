---
import VizFigure from "./VizFigure.astro";
import { FACTORY_POWER } from "src/lib/viz/data";

const W = 560;
const H = 260;
const M = { top: 16, right: 16, bottom: 28, left: 40 };
const x0 = 1899;
const x1 = 1939;
const sx = (year: number) => M.left + ((year - x0) / (x1 - x0)) * (W - M.left - M.right);
const sy = (pct: number) => M.top + (1 - pct / 100) * (H - M.top - M.bottom);

const rows = FACTORY_POWER.map((d) => {
  const total = d.purchased + d.onSite;
  return { ...d, total, purchasedPct: (d.purchased / total) * 100, onSitePct: (d.onSite / total) * 100 };
});

const line = (key: "purchasedPct" | "onSitePct") =>
  "M" + rows.map((d) => `${sx(d.year).toFixed(1)},${sy(d[key]).toFixed(1)}`).join("L");

// Hit columns span halfway to each neighbor.
const columns = rows.map((d, i) => {
  const prev = rows[i - 1];
  const next = rows[i + 1];
  const left = prev ? (sx(prev.year) + sx(d.year)) / 2 : M.left;
  const right = next ? (sx(next.year) + sx(d.year)) / 2 : W - M.right;
  return { ...d, left, width: right - left };
});

const series = [
  { key: "onSitePct" as const, label: "Generated on site", color: "var(--viz-human)" },
  { key: "purchasedPct" as const, label: "Bought from utilities", color: "var(--viz-ai)" },
];
const last = rows[rows.length - 1]!;
const fmt = (n: number) => `${Math.round(n)}%`;
---

<VizFigure
  title="Factories stopped making their own power"
  subtitle="Share of electric motor capacity in US manufacturing, by where its electricity came from"
  source="Source: <em>Historical Statistics of the United States</em>, Table Dd848-853 (Atack &amp; Bateman), horsepower of electric motors. See also Devine, “From Shafts to Wires”, 1983."
>
  <div data-controller="viz-reveal">
    <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-labelledby="factory-power-desc">
      <desc id="factory-power-desc">
        In 1909, 64% of electric motor capacity ran on power generated on site. By 1919, 57% ran on power bought from
        utilities, and by 1929, 64%.
      </desc>

      {[0, 25, 50, 75, 100].map((tick) => (
        <g>
          <line
            x1={M.left}
            x2={W - M.right}
            y1={sy(tick)}
            y2={sy(tick)}
            stroke={tick === 0 ? "var(--viz-axis)" : "var(--viz-grid)"}
          />
          <text x={M.left - 8} y={sy(tick) + 4} text-anchor="end" font-size="11" fill="var(--viz-muted)">
            {tick}%
          </text>
        </g>
      ))}
      {rows.map((d) => (
        <text x={sx(d.year)} y={H - 8} text-anchor="middle" font-size="11" fill="var(--viz-muted)">
          {d.year}
        </text>
      ))}

      {series.map((s) => (
        <path
          d={line(s.key)}
          fill="none"
          stroke={s.color}
          stroke-width="2"
          stroke-linejoin="round"
          stroke-linecap="round"
          pathLength="1"
          data-viz-reveal-target="stroke"
        />
      ))}
      {series.map((s) =>
        rows.map((d) => (
          <circle cx={sx(d.year)} cy={sy(d[s.key])} r="4" fill={s.color} stroke="var(--viz-surface)" stroke-width="2" />
        ))
      )}

      <!-- Direct labels at the right end -->
      {series.map((s) => (
        <text
          x={sx(last.year) - 6}
          y={sy(last[s.key]) + (s.key === "purchasedPct" ? -12 : 18)}
          text-anchor="end"
          font-size="12"
          font-weight="600"
          fill="var(--viz-ink)"
        >
          {s.label}
        </text>
      ))}

      <!-- Hover columns -->
      {columns.map((d) => (
        <g
          class="group"
          tabindex="0"
          data-tip={`${d.year}: ${fmt(d.purchasedPct)} from utilities`}
          data-tip-label={`${fmt(d.onSitePct)} generated on site · ${d.total.toLocaleString("en-US")}k hp of motors`}
        >
          <rect x={d.left} y={M.top} width={d.width} height={H - M.top - M.bottom} fill="transparent" />
          <line
            x1={sx(d.year)}
            x2={sx(d.year)}
            y1={M.top}
            y2={H - M.bottom}
            stroke="var(--viz-axis)"
            class="opacity-0 group-hover:opacity-100 group-focus:opacity-100"
          />
        </g>
      ))}
    </svg>

    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-600">
      {series.map((s) => (
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-0.5 w-3.5 rounded" style={`background:${s.color}`} /> {s.label}
        </span>
      ))}
    </div>

    <details class="mt-3 text-sm">
      <summary class="cursor-pointer text-xs text-stone-500">Show data table</summary>
      <table class="mt-2 w-full text-left text-xs tabular-nums">
        <thead class="text-stone-500">
          <tr>
            <th class="py-1">Year</th>
            <th>On site</th>
            <th>Utilities</th>
            <th>Motor capacity (k hp)</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((d) => (
            <tr class="border-t border-stone-200">
              <td class="py-1">{d.year}</td>
              <td>{fmt(d.onSitePct)}</td>
              <td>{fmt(d.purchasedPct)}</td>
              <td>{d.total.toLocaleString("en-US")}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </details>
  </div>
</VizFigure>
