---
import VizFigure from "./VizFigure.astro";
import MapCanvas from "./MapCanvas.astro";
import { TODAY, quadrantFor, nextMove } from "src/lib/viz/strategy-map";

const x = 0.3;
const y = 0.3;
const quadrant = quadrantFor(x, y);

const sliders = [
  {
    target: "advantage",
    value: y * 100,
    label: "How much does your company compete on this function?",
    min: "Not at all",
    max: "It’s what we compete on",
  },
  {
    target: "openness",
    value: x * 100,
    label: "How much of the intent is still open when work reaches you?",
    min: "Fully specified",
    max: "Wide open",
  },
];
---

<VizFigure title="Where does your work sit?" subtitle="Place yourself on the map, then move AI’s frontier forward.">
  <div data-controller="strategy-map" class="grid gap-6 md:grid-cols-[minmax(0,1fr)_16rem] md:items-start">
    <div>
      <MapCanvas controller="strategy-map" x={x} y={y} />
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-600">
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-[var(--viz-human)]"></span> Your work
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-2.5 w-3.5 rounded-sm border-t-2 border-[var(--viz-ai)] bg-[var(--viz-ai-wash)]"></span>{" "}
          Absorbed by AI
        </span>
      </div>
    </div>

    <div class="space-y-5 text-sm">
      {sliders.map((slider) => (
        <label class="block">
          <span class="mb-1.5 block font-medium text-stone-800">{slider.label}</span>
          <input
            type="range"
            min="0"
            max="100"
            value={slider.value}
            data-strategy-map-target={slider.target}
            data-action="input->strategy-map#update"
          />
          <span class="mt-0.5 flex justify-between text-xs text-stone-500">
            <span>{slider.min}</span>
            <span>{slider.max}</span>
          </span>
        </label>
      ))}

      <label class="block border-t border-stone-200 pt-4">
        <span class="mb-1.5 block font-medium text-stone-800">AI capability</span>
        <input
          type="range"
          min="0"
          max="100"
          value={TODAY}
          data-strategy-map-target="capability"
          data-action="input->strategy-map#update"
        />
        <span class="mt-0.5 flex justify-between text-xs text-stone-500">
          <span>Earlier</span>
          <span>Today</span>
          <span>Later</span>
        </span>
      </label>

      <div class="rounded-md border border-stone-200 bg-white p-3" aria-live="polite">
        <div class="font-semibold text-stone-800" data-strategy-map-target="quadrant">
          {quadrant.name}
        </div>
        <p class="mt-1 text-stone-600" data-strategy-map-target="description">
          {quadrant.text}
        </p>
        <p class="mt-2 flex items-start gap-1.5 font-medium" data-strategy-map-target="status"></p>
        <p class="mt-1 text-stone-500" data-strategy-map-target="move">
          {nextMove(x, y)}
        </p>
      </div>
    </div>
  </div>
</VizFigure>
