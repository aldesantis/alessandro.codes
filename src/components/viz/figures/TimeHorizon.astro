---
import VizFigure from "../ui/VizFigure.astro";
import Legend from "../ui/Legend.astro";
import SegmentedControl from "../ui/SegmentedControl.astro";
import Chart from "../chart/Chart.astro";
import XAxis from "../chart/XAxis.astro";
import YAxis from "../chart/YAxis.astro";
import DataPoint from "../chart/DataPoint.astro";
import { TIME_HORIZONS, HORIZON_RELIABLE_MAX, formatMinutes } from "src/lib/viz/data";
import { linePath, linearScale, logScale, plotArea } from "src/lib/viz/chart";

const W = 560;
const H = 300;
const plot = plotArea(W, H, { top: 16, right: 20, bottom: 28, left: 52 });
const t1 = Date.parse("2026-09-01");
const sx = linearScale([Date.parse("2019-01-01"), t1], [plot.left, plot.right]);

const points = TIME_HORIZONS.map((d) => ({ ...d, t: Date.parse(d.date) }));

// Least-squares fit of log2(minutes) over time, on reliable points since 2023.
const fitStart = Date.parse("2023-01-01");
const fitPoints = points.filter((d) => d.t >= fitStart && d.minutes <= HORIZON_RELIABLE_MAX);
const meanT = fitPoints.reduce((sum, d) => sum + d.t, 0) / fitPoints.length;
const meanY = fitPoints.reduce((sum, d) => sum + Math.log2(d.minutes), 0) / fitPoints.length;
const slope =
  fitPoints.reduce((sum, d) => sum + (d.t - meanT) * (Math.log2(d.minutes) - meanY), 0) /
  fitPoints.reduce((sum, d) => sum + (d.t - meanT) ** 2, 0);
const trend = (t: number) => 2 ** (meanY + slope * (t - meanT));
const doublingDays = Math.round(1 / slope / 86_400_000);

const scales = [
  {
    value: "log",
    label: "Log",
    max: 2000,
    y: logScale([1 / 60, 2000], [plot.bottom, plot.top]),
    ticks: [1 / 60, 1, 10, 60, 240, 960],
    labeled: new Set(["GPT-2", "GPT-4", "Claude 3.7 Sonnet", "GPT-5", "Claude Mythos Preview"]),
  },
  {
    value: "linear",
    label: "Linear",
    max: 1100,
    y: linearScale([0, 1100], [plot.bottom, plot.top]),
    ticks: [0, 240, 480, 720, 960],
    labeled: new Set(["GPT-5", "Claude Opus 4.6", "Claude Mythos Preview"]),
  },
];

type Scale = (typeof scales)[number];

const trendPath = (scale: Scale) => {
  const steps = 40;
  const pts: [number, number][] = [];
  for (let i = 0; i <= steps; i++) {
    const t = fitStart + ((t1 - fitStart) * i) / steps;
    const v = trend(t);
    if (v > scale.max) break;
    pts.push([sx(t), scale.y(v)]);
  }
  return linePath(pts);
};

const years = [2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026];
const dateLabel = (date: string) =>
  new Date(date).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
---

<VizFigure
  title="The frontier keeps moving"
  subtitle="Length of task (in human expert time) that frontier AI models complete with 50% reliability"
  source={`Source: <a class="underline" href="https://metr.org/time-horizons/">METR, Time Horizon 1.1</a>, updated May 2026. State-of-the-art models only. Trend fitted to models since 2023 below METR’s 16-hour reliability ceiling: doubling every ~${doublingDays} days.`}
>
  <div data-controller="viz-switch">
    <div class="mb-3 text-sm">
      <SegmentedControl
        controller="viz-switch"
        target="button"
        action="select"
        label="Scale"
        layout="inline"
        options={scales.map((scale) => ({ label: scale.label, value: scale.value }))}
      />
    </div>

    <Chart
      width={W}
      height={H}
      label={`From GPT-2 in 2019 at a few seconds to Claude Mythos Preview in 2026 at about 17 hours, the task length frontier models can complete has doubled roughly every ${doublingDays} days since 2023.`}
    >
      <XAxis plot={plot} x={(year) => sx(Date.parse(`${year}-01-01`))} ticks={years} />

      {scales.map((scale, index) => (
        <g data-viz-switch-target="panel" data-value={scale.value} style={index === 0 ? undefined : "display:none"}>
          <rect
            x={plot.left}
            y={plot.top}
            width={plot.width}
            height={Math.max(0, scale.y(HORIZON_RELIABLE_MAX) - plot.top)}
            fill="var(--color-stone-100)"
          />
          <text x={plot.left + 6} y={plot.top + 13} class="viz-tick">
            Above 16 hr: beyond METR’s reliable range
          </text>

          <YAxis
            plot={plot}
            y={scale.y}
            ticks={scale.ticks}
            format={(tick) => (tick === 0 ? "0" : formatMinutes(tick))}
          />

          <path
            d={trendPath(scale)}
            fill="none"
            stroke="var(--viz-ai)"
            stroke-width="2"
            stroke-linecap="round"
            opacity="0.3"
          />

          {points.map((d) => {
            const x = sx(d.t);
            const y = scale.y(d.minutes);
            const unreliable = d.minutes > HORIZON_RELIABLE_MAX;
            // Labels sit left of the dot, except near the left edge.
            const labelRight = x < plot.left + 120;
            return (
              <DataPoint
                cx={x}
                cy={y}
                color="var(--viz-ai)"
                hollow={unreliable}
                tip={formatMinutes(d.minutes)}
                tipLabel={`${d.model} · ${dateLabel(d.date)}${unreliable ? " · above reliable range" : ""}`}
              >
                {scale.labeled.has(d.model) && (
                  <text
                    x={labelRight ? x + 8 : x - 8}
                    y={y + 4}
                    text-anchor={labelRight ? "start" : "end"}
                    font-size="11"
                    fill="var(--viz-ink-2)"
                    class="viz-halo"
                  >
                    {d.model.replace("Claude Mythos Preview", "Mythos Preview")}
                  </text>
                )}
              </DataPoint>
            );
          })}
        </g>
      ))}
    </Chart>

    <Legend
      items={[
        { label: "Frontier model", color: "var(--viz-ai)", shape: "dot" },
        { label: "Trend since 2023", color: "var(--viz-ai)", shape: "line", opacity: 0.4 },
      ]}
    />
  </div>
</VizFigure>
