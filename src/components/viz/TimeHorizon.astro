---
import VizFigure from "./VizFigure.astro";
import { TIME_HORIZONS, HORIZON_RELIABLE_MAX, formatMinutes } from "src/lib/viz/data";

const W = 560;
const H = 300;
const M = { top: 16, right: 20, bottom: 28, left: 52 };
const t0 = Date.parse("2019-01-01");
const t1 = Date.parse("2026-09-01");
const sx = (t: number) => M.left + ((t - t0) / (t1 - t0)) * (W - M.left - M.right);
const plotHeight = H - M.top - M.bottom;

const points = TIME_HORIZONS.map((d) => ({ ...d, t: Date.parse(d.date) }));

// Least-squares fit of log2(minutes) over time, on reliable points since 2023.
const fitPoints = points.filter((d) => d.t >= Date.parse("2023-01-01") && d.minutes <= HORIZON_RELIABLE_MAX);
const meanT = fitPoints.reduce((sum, d) => sum + d.t, 0) / fitPoints.length;
const meanY = fitPoints.reduce((sum, d) => sum + Math.log2(d.minutes), 0) / fitPoints.length;
const slope =
  fitPoints.reduce((sum, d) => sum + (d.t - meanT) * (Math.log2(d.minutes) - meanY), 0) /
  fitPoints.reduce((sum, d) => sum + (d.t - meanT) ** 2, 0);
const trend = (t: number) => 2 ** (meanY + slope * (t - meanT));
const doublingDays = Math.round(1 / slope / 86_400_000);

const LABELED = new Set(["GPT-2", "GPT-4", "Claude 3.7 Sonnet", "GPT-5", "Claude Mythos Preview"]);
const LABELED_LINEAR = new Set(["GPT-5", "Claude Opus 4.6", "Claude Mythos Preview"]);

const scales = {
  log: {
    min: 1 / 60,
    max: 2000,
    y(v: number) {
      return M.top + (1 - Math.log(v / this.min) / Math.log(this.max / this.min)) * plotHeight;
    },
    ticks: [1 / 60, 1, 10, 60, 240, 960],
    labeled: LABELED,
  },
  linear: {
    min: 0,
    max: 1100,
    y(v: number) {
      return M.top + (1 - v / this.max) * plotHeight;
    },
    ticks: [0, 240, 480, 720, 960],
    labeled: LABELED_LINEAR,
  },
};

type Scale = (typeof scales)[keyof typeof scales];

const trendPath = (scale: Scale) => {
  const start = Date.parse("2023-01-01");
  const steps = 40;
  const pts: string[] = [];
  for (let i = 0; i <= steps; i++) {
    const t = start + ((t1 - start) * i) / steps;
    const v = trend(t);
    if (v > scale.max) break;
    pts.push(`${sx(t).toFixed(1)},${scale.y(v).toFixed(1)}`);
  }
  return "M" + pts.join("L");
};

const years = [2019, 2020, 2021, 2022, 2023, 2024, 2025, 2026];
const dateLabel = (date: string) =>
  new Date(date).toLocaleDateString("en-US", { month: "short", year: "numeric", timeZone: "UTC" });
---

<VizFigure
  title="The frontier keeps moving"
  subtitle="Length of task (in human expert time) that frontier AI models complete with 50% reliability"
  source={`Source: <a class="underline" href="https://metr.org/time-horizons/">METR, Time Horizon 1.1</a>, updated May 2026. State-of-the-art models only. Trend fitted to models since 2023 below METR’s 16-hour reliability ceiling: doubling every ~${doublingDays} days.`}
>
  <div data-controller="viz-scale">
    <div class="mb-3 flex items-center gap-1.5 text-sm">
      <span class="mr-1 text-xs text-stone-500">Scale</span>
      <button
        type="button"
        class="viz-segment"
        aria-pressed="true"
        data-viz-scale-target="button"
        data-scale="log"
        data-action="viz-scale#select"
      >
        Log
      </button>
      <button
        type="button"
        class="viz-segment"
        aria-pressed="false"
        data-viz-scale-target="button"
        data-scale="linear"
        data-action="viz-scale#select"
      >
        Linear
      </button>
    </div>

    <svg viewBox={`0 0 ${W} ${H}`} class="h-auto w-full" role="img" aria-labelledby="time-horizon-desc">
      <desc id="time-horizon-desc">
        From GPT-2 in 2019 at a few seconds to Claude Mythos Preview in 2026 at about 17 hours, the task length frontier
        models can complete has doubled roughly every {doublingDays} days since 2023.
      </desc>

      {years.map((year) => {
        const x = sx(Date.parse(`${year}-01-01`));
        return (
          <text x={x} y={H - 8} text-anchor="middle" font-size="11" fill="var(--viz-muted)">
            {year}
          </text>
        );
      })}

      {Object.entries(scales).map(([name, scale]) => (
        <g data-viz-scale-target="layer" data-scale={name} display={name === "log" ? "inline" : "none"}>
          <rect
            x={M.left}
            y={M.top}
            width={W - M.left - M.right}
            height={Math.max(0, scale.y(HORIZON_RELIABLE_MAX) - M.top)}
            fill="var(--color-stone-100)"
          />
          <text x={M.left + 6} y={M.top + 13} font-size="11" fill="var(--viz-muted)">
            Above 16 hr: beyond METR’s reliable range
          </text>

          {scale.ticks.map((tick) => (
            <g>
              <line
                x1={M.left}
                x2={W - M.right}
                y1={scale.y(tick)}
                y2={scale.y(tick)}
                stroke={tick === scale.ticks[0] ? "var(--viz-axis)" : "var(--viz-grid)"}
              />
              <text x={M.left - 8} y={scale.y(tick) + 4} text-anchor="end" font-size="11" fill="var(--viz-muted)">
                {tick === 0 ? "0" : formatMinutes(tick)}
              </text>
            </g>
          ))}

          <path
            d={trendPath(scale)}
            fill="none"
            stroke="var(--viz-ai)"
            stroke-width="2"
            stroke-linecap="round"
            opacity="0.3"
          />

          {points.map((d) => {
            const x = sx(d.t);
            const y = scale.y(d.minutes);
            const unreliable = d.minutes > HORIZON_RELIABLE_MAX;
            // Labels sit left of the dot, except near the left edge.
            const labelRight = x < M.left + 120;
            return (
              <g
                tabindex="0"
                data-tip={formatMinutes(d.minutes)}
                data-tip-label={`${d.model} · ${dateLabel(d.date)}${unreliable ? " · above reliable range" : ""}`}
              >
                <circle cx={x} cy={y} r="12" fill="transparent" />
                <circle
                  cx={x}
                  cy={y}
                  r="4.5"
                  fill={unreliable ? "var(--viz-surface)" : "var(--viz-ai)"}
                  stroke={unreliable ? "var(--viz-ai)" : "var(--viz-surface)"}
                  stroke-width="2"
                />
                {scale.labeled.has(d.model) && (
                  <text
                    x={labelRight ? x + 8 : x - 8}
                    y={y + 4}
                    text-anchor={labelRight ? "start" : "end"}
                    font-size="11"
                    fill="var(--viz-ink-2)"
                    paint-order="stroke"
                    stroke="var(--viz-surface)"
                    stroke-width="3"
                  >
                    {d.model.replace("Claude Mythos Preview", "Mythos Preview")}
                  </text>
                )}
              </g>
            );
          })}
        </g>
      ))}
    </svg>

    <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-600">
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-block h-2.5 w-2.5 rounded-full bg-[var(--viz-ai)]"></span> Frontier model
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-block h-0.5 w-3.5 rounded bg-[var(--viz-ai)] opacity-40"></span> Trend since 2023
      </span>
    </div>
  </div>
</VizFigure>
