---
import VizFigure from "./VizFigure.astro";
import MapCanvas from "./MapCanvas.astro";

// From §4: the same profession is an advantage at one company and a necessity
// at another.
const professions = [
  {
    name: "Engineer",
    companies: [
      {
        name: "Software company",
        y: 0.88,
        note: "Software is the product. As building gets cheaper, the cost of not building rises, so they’ll build more.",
      },
      {
        name: "Consumer brand",
        y: 0.16,
        note: "Engineering is a necessity. The brand builds a good-enough store and stops.",
      },
    ],
  },
  {
    name: "Designer",
    companies: [
      { name: "Fashion brand", y: 0.86, note: "Design is the advantage for a brand that competes on taste." },
      { name: "B2B distributor", y: 0.14, note: "Design is a necessity. The distributor just needs a usable catalog." },
    ],
  },
  {
    name: "Scientist",
    companies: [
      {
        name: "Pharma R&D",
        y: 0.92,
        note: "R&D’s job is, by definition, to find the original insight the company competes on.",
      },
      { name: "Quality control", y: 0.22, note: "The same scientist doing quality control is doing necessity work." },
    ],
  },
  {
    name: "Chef",
    companies: [
      { name: "Restaurant group", y: 0.9, note: "The chef developing the menu is the group’s R&D." },
      { name: "Corporate cafeteria", y: 0.14, note: "Running a corporate cafeteria is necessity work." },
    ],
  },
];

const roles = [
  { name: "Mostly executing", x: 0.22 },
  { name: "Mostly deciding", x: 0.76 },
];

const first = professions[0]!;
---

<VizFigure title="Same profession, different company" subtitle="Pick a profession, then switch companies and roles.">
  <div
    data-controller="profession-map"
    data-profession-map-professions-value={JSON.stringify(professions)}
    data-profession-map-roles-value={JSON.stringify(roles)}
    class="grid gap-6 md:grid-cols-[minmax(0,1fr)_16rem] md:items-start"
  >
    <div>
      <MapCanvas controller="profession-map" x={roles[0]!.x} y={first.companies[0]!.y} dotLabel="" ghost />
      <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-600">
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-2.5 w-2.5 rounded-full bg-[var(--viz-human)]"></span> Selected company
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-2.5 w-2.5 rounded-full border-2 border-[var(--viz-human)] opacity-60"></span> The
          other company
        </span>
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-2.5 w-3.5 rounded-sm border-t-2 border-[var(--viz-ai)] bg-[var(--viz-ai-wash)]"></span>{" "}
          Absorbed by AI today
        </span>
      </div>
    </div>

    <div class="space-y-4 text-sm">
      <div>
        <div class="mb-1.5 font-medium text-stone-800">Profession</div>
        <div class="flex flex-wrap gap-1.5">
          {professions.map((profession, index) => (
            <button
              type="button"
              class="viz-segment"
              aria-pressed={index === 0 ? "true" : "false"}
              data-profession-map-target="professionButton"
              data-action="profession-map#selectProfession"
              data-index={index}
            >
              {profession.name}
            </button>
          ))}
        </div>
      </div>

      <div>
        <div class="mb-1.5 font-medium text-stone-800">Company</div>
        <div class="flex flex-wrap gap-1.5">
          {[0, 1].map((index) => (
            <button
              type="button"
              class="viz-segment"
              aria-pressed={index === 0 ? "true" : "false"}
              data-profession-map-target="companyButton"
              data-action="profession-map#selectCompany"
              data-index={index}
            >
              {first.companies[index]!.name}
            </button>
          ))}
        </div>
      </div>

      <div>
        <div class="mb-1.5 font-medium text-stone-800">Role</div>
        <div class="flex flex-wrap gap-1.5">
          {roles.map((role, index) => (
            <button
              type="button"
              class="viz-segment"
              aria-pressed={index === 0 ? "true" : "false"}
              data-profession-map-target="roleButton"
              data-action="profession-map#selectRole"
              data-index={index}
            >
              {role.name}
            </button>
          ))}
        </div>
      </div>

      <div class="rounded-md border border-stone-200 bg-white p-3" aria-live="polite">
        <div class="font-semibold text-stone-800" data-profession-map-target="quadrant"></div>
        <p class="mt-1 text-stone-600" data-profession-map-target="note"></p>
        <p class="mt-2 text-stone-500" data-profession-map-target="description"></p>
      </div>
    </div>
  </div>
</VizFigure>
