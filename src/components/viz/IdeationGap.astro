---
import VizFigure from "./VizFigure.astro";
import { IDEATION_GAP } from "src/lib/viz/data";

const W = 170;
const H = 210;
const M = { top: 28, bottom: 34, left: 34, right: 34 };
const yMin = 3;
const yMax = 6.5;
const sy = (v: number) => M.top + (1 - (v - yMin) / (yMax - yMin)) * (H - M.top - M.bottom);
const xs = [M.left, W - M.right];
const stages = ["Ideas", "Executed"];

const series = [
  { key: "human" as const, label: "Human ideas", color: "var(--viz-human)" },
  { key: "ai" as const, label: "AI ideas", color: "var(--viz-ai)" },
];
const fmt = (n: number) => n.toFixed(1);

// Value labels sit beside their dots; push them apart when the dots are close.
const MIN_GAP = 13;
const labelY = (row: (typeof IDEATION_GAP)[number], key: "human" | "ai", stage: number) => {
  const own = sy(row[key][stage]!);
  const other = sy(row[key === "human" ? "ai" : "human"][stage]!);
  const gap = Math.abs(own - other);
  if (gap >= MIN_GAP) return own;
  const push = (MIN_GAP - gap) / 2;
  return own < other ? own - push : own + push;
};
---

<VizFigure
  title="AI ideas look better before they’re executed"
  subtitle="Mean expert ratings (1–10) of the same research ideas, before and after ~100 hours of execution"
  source="Source: Si, Hashimoto &amp; Yang, “The Ideation–Execution Gap”, 2025, Tables 4–5. 19 human and 24 AI ideas. Before execution, AI ideas scored higher on every metric. After, the differences were not significant."
>
  <div class="mb-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-600">
    {series.map((s) => (
      <span class="inline-flex items-center gap-1.5">
        <span class="inline-block h-0.5 w-3.5 rounded" style={`background:${s.color}`} /> {s.label}
      </span>
    ))}
  </div>

  <div class="grid grid-cols-2 gap-x-4 gap-y-2 sm:grid-cols-4">
    {IDEATION_GAP.map((row) => (
      <svg
        viewBox={`0 0 ${W} ${H}`}
        class="h-auto w-full"
        role="img"
        aria-label={`${row.metric}: human ideas ${fmt(row.human[0])} → ${fmt(row.human[1])}, AI ideas ${fmt(row.ai[0])} → ${fmt(row.ai[1])}`}
      >
        <text x={W / 2} y="14" text-anchor="middle" font-size="13" font-weight="600" fill="var(--viz-ink)">
          {row.metric}
        </text>
        {xs.map((x, i) => (
          <g>
            <line x1={x} x2={x} y1={M.top - 4} y2={H - M.bottom + 4} stroke="var(--viz-grid)" />
            <text x={x} y={H - 12} text-anchor="middle" font-size="11" fill="var(--viz-muted)">
              {stages[i]}
            </text>
          </g>
        ))}
        {series.map((s) => {
          const values = row[s.key];
          return (
            <g>
              <line
                x1={xs[0]}
                y1={sy(values[0]!)}
                x2={xs[1]}
                y2={sy(values[1]!)}
                stroke={s.color}
                stroke-width="2"
                stroke-linecap="round"
              />
              {values.map((v, i) => (
                <g
                  tabindex="0"
                  data-tip={fmt(v)}
                  data-tip-label={`${s.label}, ${stages[i]!.toLowerCase()} · ${row.metric.toLowerCase()}`}
                >
                  <circle cx={xs[i]} cy={sy(v)} r="12" fill="transparent" />
                  <circle cx={xs[i]} cy={sy(v)} r="4.5" fill={s.color} stroke="var(--viz-surface)" stroke-width="2" />
                  <text
                    x={xs[i]! + (i === 0 ? -9 : 9)}
                    y={labelY(row, s.key, i) + 4}
                    text-anchor={i === 0 ? "end" : "start"}
                    font-size="11"
                    fill="var(--viz-ink-2)"
                    class="tabular-nums"
                  >
                    {fmt(v)}
                  </text>
                </g>
              ))}
            </g>
          );
        })}
      </svg>
    ))}
  </div>
</VizFigure>
