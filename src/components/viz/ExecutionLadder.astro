---
import VizFigure from "./VizFigure.astro";

// §2: the software spectrum, from most translation to most meaningmaking.
// `translation` is an illustrative share, not a measurement.
const rungs = [
  { label: "Choosing which customers to build for", translation: 0.1 },
  { label: "Choosing which features to build", translation: 0.25 },
  { label: "Designing the system behind a feature", translation: 0.55 },
  { label: "Implementing a feature from a spec", translation: 0.8 },
  { label: "Typing out a function someone else specified", translation: 0.95 },
];

const legend = [
  { label: "Absorbed by AI", class: "bg-[var(--viz-ai)]" },
  { label: "Translation still done by people", class: "bg-stone-300" },
  { label: "Meaningmaking", class: "bg-[var(--viz-human)]" },
];
---

<VizFigure
  title="AI climbs the ladder from the execution end"
  subtitle="Each rung mixes translation and meaningmaking. Raise AI capability and watch which work goes first."
  source="Shares are illustrative, not measured."
>
  <div data-controller="execution-ladder" data-execution-ladder-rungs-value={JSON.stringify(rungs)}>
    <div class="mb-1 flex justify-between text-xs font-semibold uppercase tracking-wider text-stone-500">
      <span>More strategy</span>
    </div>
    <ol class="space-y-3">
      {rungs.map((rung) => (
        <li>
          <div class="mb-1 flex items-baseline justify-between gap-3 text-sm">
            <span class="text-stone-800">{rung.label}</span>
            <span class="shrink-0 text-xs tabular-nums text-stone-500" data-execution-ladder-target="share" />
          </div>
          <div class="flex h-3 gap-0.5 overflow-hidden rounded">
            <div
              class="viz-animate h-full rounded-l bg-[var(--viz-ai)]"
              style="width:0%"
              data-execution-ladder-target="ai"
            />
            <div
              class="viz-animate h-full bg-stone-300"
              style={`width:${rung.translation * 100}%`}
              data-execution-ladder-target="translation"
            />
            <div
              class="h-full flex-1 rounded-r bg-[var(--viz-human)]"
              data-tip={`${Math.round((1 - rung.translation) * 100)}% meaningmaking`}
              data-tip-label={rung.label}
            />
          </div>
        </li>
      ))}
    </ol>
    <div class="mt-1 text-xs font-semibold uppercase tracking-wider text-stone-500">More execution</div>

    <label class="mt-5 block border-t border-stone-200 pt-4 text-sm">
      <span class="mb-1.5 flex justify-between font-medium text-stone-800">
        <span>AI capability</span>
        <span class="font-normal text-stone-500" data-execution-ladder-target="summary"></span>
      </span>
      <input
        type="range"
        min="0"
        max="100"
        value="35"
        data-execution-ladder-target="capability"
        data-action="input->execution-ladder#update"
      />
      <span class="mt-0.5 flex justify-between text-xs text-stone-500">
        <span>Autocomplete</span>
        <span>Ships software end to end</span>
      </span>
    </label>

    <div class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-xs text-stone-600">
      {legend.map((item) => (
        <span class="inline-flex items-center gap-1.5">
          <span class={`inline-block h-2.5 w-2.5 rounded-sm ${item.class}`} /> {item.label}
        </span>
      ))}
    </div>
  </div>
</VizFigure>
