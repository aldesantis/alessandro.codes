---
interface Props {
  title: string;
  subtitle?: string;
  source?: string;
}

const { title, subtitle, source } = Astro.props;
---

<figure
  class="viz not-prose relative my-10 rounded-lg border border-rule bg-surface px-5 py-5 font-sans text-stone-700"
  data-controller="viz-tooltip"
>
  {/* The caption names the figure for assistive tech; the source sits below. */}
  <figcaption class="mb-4">
    <div class="text-base font-semibold text-ink">{title}</div>
    {subtitle && <div class="mt-0.5 text-sm text-ink-subtle">{subtitle}</div>}
  </figcaption>
  <slot />
  {source && <p class="mt-4 text-xs text-ink-subtle" set:html={source} />}
</figure>
