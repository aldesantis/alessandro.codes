---
// A collapsible table with the numbers behind a chart.
interface Props {
  columns: string[];
  rows: (string | number)[][];
  summary?: string;
}

const { columns, rows, summary = "Show data table" } = Astro.props;
---

<details class="mt-3 text-sm">
  <summary class="cursor-pointer text-xs text-stone-500">{summary}</summary>
  <table class="mt-2 w-full text-left text-xs tabular-nums">
    <thead class="text-stone-500">
      <tr>
        {columns.map((column) => (
          <th class="py-1">{column}</th>
        ))}
      </tr>
    </thead>
    <tbody>
      {rows.map((row) => (
        <tr class="border-t border-stone-200">
          {row.map((cell) => (
            <td class="py-1">{cell}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</details>
