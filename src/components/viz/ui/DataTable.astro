---
import ChevronDownIcon from "src/components/ui/icons/ChevronDownIcon.astro";

// A collapsible table with the numbers behind a chart.
interface Props {
  columns: string[];
  rows: (string | number)[][];
  summary?: string;
}

const { columns, rows, summary = "Show data table" } = Astro.props;
---

<details class="group mt-3 text-sm">
  <summary class="-my-1 inline-flex cursor-pointer list-none items-center gap-1 rounded-sm py-1 text-xs text-ink-subtle transition-colors hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link [&::-webkit-details-marker]:hidden">
    {summary}
    <ChevronDownIcon class="group-open:rotate-180" />
  </summary>
  <div class="mt-2 overflow-x-auto">
    <table class="w-full text-left text-xs tabular-nums">
      <thead class="text-ink-subtle">
        <tr>
          {columns.map((column) => (
            <th class="py-1 pr-3 last:pr-0">{column}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-t border-rule">
            {row.map((cell) => (
              <td class="py-1 pr-3 last:pr-0">{cell}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</details>
