---
import { targetAttr } from "src/lib/viz/stimulus";

// A row of toggle buttons on one track. Each button carries `data-index` and
// `data-value`; read the index with `eventIndex()` from src/controllers/viz/helpers.
interface Props {
  controller: string;
  target: string;
  // Controller method to call on click.
  action: string;
  options: { label: string; value?: string }[];
  label?: string;
  // "stacked" puts the label above the buttons, "inline" beside them.
  layout?: "stacked" | "inline";
  selected?: number;
}

const { controller, target, action, options, label, layout = "stacked", selected = 0 } = Astro.props;
const labelId = `viz-segments-${Math.random().toString(36).slice(2, 10)}`;
---

<div class:list={[layout === "inline" && "flex items-center gap-1.5"]}>
  {label && (
    <div id={labelId} class:list={layout === "inline" ? "mr-1 text-xs text-ink-subtle" : "mb-1.5 font-medium text-ink"}>
      {label}
    </div>
  )}
  <div
    class="inline-flex gap-0.5 rounded-full border border-rule p-0.5"
    role="group"
    aria-labelledby={label ? labelId : undefined}
  >
    {options.map((option, index) => (
      <button
        type="button"
        class="viz-segment"
        aria-pressed={index === selected ? "true" : "false"}
        data-action={`${controller}#${action}`}
        data-index={index}
        data-value={option.value ?? String(index)}
        {...targetAttr(controller, target)}
      >
        {option.label}
      </button>
    ))}
  </div>
</div>
