---
import ContentListItem from "@components/content/grid/ContentListItem.astro";
import NoteMeta from "@components/content/notes/NoteMeta.astro";
import type { CollectionEntry } from "astro:content";
import { getFirstParagraph, renderToString } from "src/lib/rendering";

interface Props {
  note: CollectionEntry<"notes">;
}

const { note } = Astro.props;
const renderedNote = await renderToString(note);
---

<ContentListItem href={`/notes/${note.id}`} title={note.data.title} summary={getFirstParagraph(renderedNote)}>
  <NoteMeta content={note} compact />
</ContentListItem>
