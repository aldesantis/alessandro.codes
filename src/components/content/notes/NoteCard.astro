---
import LinkedCard from "@components/ui/LinkedCard.astro";
import NoteMeta from "@components/content/notes/NoteMeta.astro";
import type { CollectionEntry } from "astro:content";
import { getFirstParagraph, renderToString } from "src/lib/rendering";

interface Props {
  note: CollectionEntry<"notes">;
  headingLevel?: 2 | 3;
}

const { note, headingLevel } = Astro.props;

const excerpt = getFirstParagraph(await renderToString(note));
---

<LinkedCard href={`/notes/${note.id}`} headingLevel={headingLevel}>
  <Fragment slot="title">{note.data.title}</Fragment>

  <NoteMeta content={note} compact />

  {excerpt && <p class="mt-2 line-clamp-3 font-serif text-sm text-ink-muted">{excerpt}</p>}
</LinkedCard>
