---
import LinkedCard from "@components/ui/LinkedCard.astro";
import TopicMeta from "@components/content/topics/TopicMeta.astro";
import type { CollectionEntry } from "astro:content";
import { getFirstParagraph, renderToString } from "src/lib/rendering";

export interface Props {
  topic: CollectionEntry<"topics">;
  headingLevel?: 2 | 3;
}

const { topic, headingLevel } = Astro.props;

const excerpt = getFirstParagraph(await renderToString(topic));
---

<LinkedCard href={`/topics/${topic.id}`} headingLevel={headingLevel}>
  <Fragment slot="title">{topic.data.title}</Fragment>

  <TopicMeta content={topic} compact />

  {excerpt && <p class="mt-2 line-clamp-3 font-serif text-sm text-ink-muted">{excerpt}</p>}
</LinkedCard>
