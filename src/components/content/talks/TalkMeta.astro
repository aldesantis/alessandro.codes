---
import LanguageDisplay from "@components/ui/LanguageDisplay.astro";
import RelativeDate from "@components/ui/RelativeDate.astro";
import TopicList from "@components/content/topics/TopicList.astro";
import type { CollectionEntry } from "astro:content";

export interface Props {
  content: CollectionEntry<"talks">;
  compact?: boolean;
}

const { content, compact = false } = Astro.props;
---

<div class="font-sans text-sm text-ink-subtle">
  <span>
    <LanguageDisplay language={content.data.language} />
  </span>
  <span class="mx-0.5">•</span>
  <span>
    Published <RelativeDate date={content.data.createdAt} />
  </span>

  {!compact && content.data.topics && content.data.topics.length > 0 && (
    <>
      <span class="mx-0.5">•</span>
      <TopicList topics={content.data.topics} />
    </>
  )}
</div>
