---
import Card from "@components/ui/Card.astro";
import TalkMeta from "@components/content/talks/TalkMeta.astro";
import type { CollectionEntry } from "astro:content";
import { getYouTubeEmbedUrl } from "src/lib/utils/youtube";

interface Props {
  talk: CollectionEntry<"talks">;
  headingLevel?: 2 | 3;
}

const { talk, headingLevel } = Astro.props;
const embedUrl = getYouTubeEmbedUrl(talk.data.url);

function escapeHtml(value: string): string {
  return value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

// Click-to-load facade: the iframe starts as a tiny srcdoc page showing the
// YouTube thumbnail and a play button, which links to the real player with
// autoplay. Nothing from YouTube but one image loads until the visitor clicks,
// and it needs no script, so it also works when the card is fetched and
// inserted by the grid.
const videoId = embedUrl.startsWith("https://www.youtube.com/embed/")
  ? new URL(embedUrl).pathname.split("/").pop()
  : undefined;

let facade: string | undefined;

if (videoId) {
  const playerUrl = new URL(embedUrl);
  playerUrl.searchParams.set("autoplay", "1");

  facade = `<!doctype html><style>
*{margin:0;padding:0;box-sizing:border-box}
html,body{height:100%;overflow:hidden;background:#1c1917}
a{position:relative;display:block;height:100%}
img{width:100%;height:100%;object-fit:cover}
span{position:absolute;inset:0;margin:auto;width:68px;height:48px;border-radius:14px;background:rgb(28 25 23/.8);transition:background .2s}
span::after{content:"";position:absolute;inset:0;margin:auto;width:0;height:0;border-style:solid;border-width:10px 0 10px 17px;border-color:transparent transparent transparent #fff;transform:translateX(2px)}
a:hover span,a:focus-visible span{background:#c2410c}
a:focus-visible{outline:3px solid #c2410c;outline-offset:-3px}
</style><a href="${escapeHtml(playerUrl.toString())}" aria-label="Play video: ${escapeHtml(talk.data.title)}"><img src="https://i.ytimg.com/vi/${escapeHtml(videoId)}/hqdefault.jpg" alt=""><span></span></a>`;
}
---

<Card headingLevel={headingLevel} data-card>
  <a
    slot="title"
    href={talk.data.url}
    target="_blank"
    rel="noopener noreferrer"
    class="rounded-md text-ink transition-colors duration-200 ease-out-strong hover:text-link focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link"
  >
    {talk.data.title}
    <svg
      aria-hidden="true"
      focusable="false"
      viewBox="0 0 12 12"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="inline-block size-[0.6em] align-[0.15em] opacity-70"
    >
      <path d="M4 2.5h5.5V8M9.5 2.5 2.5 9.5"></path>
    </svg>
    <span class="sr-only"> (opens in new tab)</span>
  </a>

  <TalkMeta content={talk} />

  {talk.data.description && <p class="mt-2 font-serif text-sm text-ink-muted">{talk.data.description}</p>}

  <iframe
    slot="cover"
    class="block aspect-video w-full bg-stone-900"
    src={facade ? undefined : embedUrl}
    srcdoc={facade}
    loading="lazy"
    title={`Video: ${talk.data.title}`}
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
</Card>
