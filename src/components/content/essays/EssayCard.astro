---
import LinkedCard from "@components/ui/LinkedCard.astro";
import EssayMeta from "@components/content/essays/EssayMeta.astro";
import type { CollectionEntry } from "astro:content";
import { getFirstParagraph, renderToString } from "src/lib/rendering";

export interface Props {
  essay: CollectionEntry<"essays">;
  headingLevel?: 2 | 3;
}

const { essay, headingLevel } = Astro.props;

const excerpt = getFirstParagraph(await renderToString(essay));
---

<LinkedCard href={`/essays/${essay.id}`} headingLevel={headingLevel}>
  <Fragment slot="title">{essay.data.title}</Fragment>

  <EssayMeta content={essay} compact />

  {excerpt && <p class="mt-2 line-clamp-3 font-serif text-sm text-ink-muted">{excerpt}</p>}
</LinkedCard>
