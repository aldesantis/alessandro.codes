---
import ContentListItem from "@components/content/grid/ContentListItem.astro";
import EssayMeta from "@components/content/essays/EssayMeta.astro";
import type { CollectionEntry } from "astro:content";
import { getFirstParagraph, renderToString } from "src/lib/rendering";

export interface Props {
  essay: CollectionEntry<"essays">;
}

const { essay } = Astro.props;

const renderedEssay = await renderToString(essay);
---

<ContentListItem href={`/essays/${essay.id}`} title={essay.data.title} summary={getFirstParagraph(renderedEssay)}>
  <EssayMeta content={essay} compact />
</ContentListItem>
