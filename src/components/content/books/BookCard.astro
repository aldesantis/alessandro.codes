---
import LinkedCard from "@components/ui/LinkedCard.astro";
import BookMeta from "@components/content/books/BookMeta.astro";
import BookCover from "@components/content/books/BookCover.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  book: CollectionEntry<"books">;
  headingLevel?: 2 | 3;
}

const { book, headingLevel } = Astro.props;

// Real covers range from 1.13 to 1.60 tall; a fixed 2:3 frame keeps rows even.
---

<LinkedCard href={`/books/${book.id}`} headingLevel={headingLevel}>
  <BookCover book={book} class="aspect-[2/3] w-full object-cover object-top" slot="cover" />

  <Fragment slot="title">{book.data.title}</Fragment>

  <BookMeta content={book} compact />
</LinkedCard>
