---
import type { CollectionEntry } from "astro:content";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

async function fetchBookCover(book: CollectionEntry<"books">): Promise<ImageMetadata | undefined> {
  const images = import.meta.glob<{ default: ImageMetadata }>("/src/content/assets/covers/*.jpg");

  const image = images[`/src/content/assets/covers/${book.id.toLowerCase()}.jpg`];

  if (!image) {
    // Render a placeholder rather than failing the build over a missing asset.
    console.warn(`[cover] Cannot find cover for ${book.id}, rendering a placeholder`);
    return undefined;
  }

  return (await image()).default;
}

interface Props {
  book: CollectionEntry<"books">;
  class?: string;
  /** Pass "eager" for above-the-fold (LCP) placements; fetchpriority follows. */
  loading?: "lazy" | "eager";
}

const { book, class: className, loading = "lazy" } = Astro.props;
const image = await fetchBookCover(book);
const initials = book.data.title
  .split(/\s+/)
  .filter((word) => /^[\p{L}\p{N}]/u.test(word))
  .slice(0, 2)
  .map((word) => word.charAt(0).toUpperCase())
  .join("");
---

{image ? (
  <Image
    src={image}
    alt={`${book.data.title} cover`}
    loading={loading}
    fetchpriority={loading === "eager" ? "high" : undefined}
    decoding="async"
    quality={50}
    format="webp"
    width={600}
    class={className}
  />
) : (
  <div
    role="img"
    aria-label={`${book.data.title} cover`}
    class:list={[
      "flex aspect-[2/3] items-center justify-center border border-rule bg-paper font-serif text-3xl text-ink-subtle select-none",
      className,
    ]}
  >
    <span aria-hidden="true">{initials}</span>
  </div>
)}
