---
export interface Props {
  status: "seedling" | "budding" | "evergreen";
}

const { status } = Astro.props;

const statusLabel = {
  seedling: "Seedling",
  budding: "Budding",
  evergreen: "Evergreen",
}[status];

const statusIcon = {
  seedling: "🌱",
  budding: "🌿",
  evergreen: "🌳",
}[status];
---

<span title={statusLabel}>{statusIcon}</span>
