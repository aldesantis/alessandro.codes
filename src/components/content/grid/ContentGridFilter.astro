---
import ContentGridFilterItem from "./ContentGridFilterItem.astro";
import ChevronDownIcon from "@components/ui/icons/ChevronDownIcon.astro";

interface Props {
  label: string;
  filterCategory: string;
  items: { id: string; label: string }[];
  /** Optional one-line explanation shown under the options. */
  legend?: string;
}

const { label, filterCategory, items, legend } = Astro.props;
const menuId = `content-filter-${filterCategory}`;
---

<div
  data-controller="content-filter"
  data-action="keydown.esc->content-filter#closeAndFocus"
  class="relative font-sans"
>
  <button
    type="button"
    aria-expanded="false"
    aria-controls={menuId}
    data-content-filter-target="button"
    data-content-grid-target="filterButton"
    data-filter-category={filterCategory}
    data-action="click->content-filter#toggle"
    class:list={[
      "group inline-flex min-h-9 max-w-full cursor-pointer items-center justify-center gap-2 pointer-coarse:min-h-11",
      "rounded-md border border-rule bg-surface px-3 py-1.5",
      "text-sm text-ink",
      "transition-[color,background-color,border-color,scale] duration-150 ease-out-strong",
      "hover:border-ink-subtle aria-expanded:border-ink-subtle data-active:border-link",
      "active:scale-[0.97] motion-reduce:active:scale-100",
      "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link",
    ]}
  >
    <span class="flex min-w-0">
      <span class="shrink-0">{label}</span>
      <span
        data-content-grid-target="filterValue"
        data-filter-category={filterCategory}
        class="max-w-48 truncate font-semibold text-link"
      ></span>
    </span>
    <ChevronDownIcon class="shrink-0 text-ink-subtle duration-150 group-aria-expanded:rotate-180 motion-reduce:transition-none" />
  </button>

  <div
    id={menuId}
    role="group"
    aria-label={label}
    data-content-filter-target="menu"
    class:list={[
      "absolute left-0 z-10 mt-2 w-max min-w-44 max-w-[min(20rem,calc(100vw-1.5rem))] origin-top-left",
      "rounded-lg border border-rule bg-surface shadow-pop",
      "hidden scale-95 opacity-0",
      "transition-[opacity,scale] duration-150 ease-out-strong motion-reduce:scale-100 motion-reduce:transition-opacity",
    ]}
  >
    <div class="max-h-80 overflow-y-auto py-1">
      <ContentGridFilterItem id="all" label="All" filterCategory={filterCategory} isAll={true} />
      {items.map((item) => (
        <ContentGridFilterItem id={item.id} label={item.label} filterCategory={filterCategory} />
      ))}
    </div>
    {legend && <p class="border-t border-rule px-3 py-2 text-xs text-pretty text-ink-muted">{legend}</p>}
  </div>
</div>
