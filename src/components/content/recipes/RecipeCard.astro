---
import LinkedCard from "@components/ui/LinkedCard.astro";
import RecipeMeta from "@components/content/recipes/RecipeMeta.astro";
import RecipeIllustration from "@components/content/recipes/RecipeIllustration.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  recipe: CollectionEntry<"recipes">;
  headingLevel?: 2 | 3;
}

const { recipe, headingLevel } = Astro.props;
---

<LinkedCard href={`/recipes/${recipe.id}`} headingLevel={headingLevel}>
  <RecipeIllustration recipe={recipe} class="w-full object-cover object-top" slot="cover" />

  <Fragment slot="title">{recipe.data.title}</Fragment>

  <RecipeMeta content={recipe} compact />
</LinkedCard>
