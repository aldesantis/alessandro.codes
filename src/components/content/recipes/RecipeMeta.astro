---
import type { CollectionEntry } from "astro:content";
import Meta from "@components/ui/Meta.astro";
import RelativeDate from "@components/ui/RelativeDate.astro";
import { getRecipeDiets, mostRestrictiveDiets, type Diet } from "src/lib/recipes/diets";
import types from "./types.json";
import cuisines from "./cuisines.json";
import diets from "./diets.json";

export interface Props {
  content: CollectionEntry<"recipes">;
  /** Card mode: course, cuisine and servings; the "revisited" date and diets are left to the page. */
  compact?: boolean;
}

const { content, compact = false } = Astro.props;

const recipeDiets = mostRestrictiveDiets(await getRecipeDiets(content));

type recipeType = CollectionEntry<"recipes">["data"]["type"];
type RecipeCuisine = CollectionEntry<"recipes">["data"]["cuisine"];
type RecipeDiet = Diet;

const TYPE_MAP = types satisfies Record<recipeType, { emoji: string; label: string }>;
const CUISINE_MAP = cuisines satisfies Record<RecipeCuisine, { emoji: string; label: string }>;
const DIET_MAP = diets satisfies Record<RecipeDiet, { emoji: string; label: string }>;

type Display = { emoji: string; label: string };

const typeDisplay: Display | undefined = content.data.type ? TYPE_MAP[content.data.type] : undefined;
const cuisineDisplay: Display | undefined = content.data.cuisine ? CUISINE_MAP[content.data.cuisine] : undefined;
const dietDisplays: Display[] = recipeDiets.map((diet: RecipeDiet) => DIET_MAP[diet]);
---

<Meta>
  {!compact && content.data.updatedAt && (
    <span>
      Revisited <RelativeDate date={content.data.updatedAt} />
    </span>
  )}

  {typeDisplay && (
    <span>
      <span aria-hidden="true">{typeDisplay.emoji}</span> {typeDisplay.label}
    </span>
  )}

  {cuisineDisplay && (
    <span>
      <span aria-hidden="true">{cuisineDisplay.emoji}</span> {cuisineDisplay.label}
    </span>
  )}

  {compact && content.data.serves && <span>Serves {content.data.serves}</span>}

  {!compact &&
    dietDisplays.map((diet) => (
      <span>
        <span aria-hidden="true">{diet.emoji}</span> {diet.label}
      </span>
    ))}
</Meta>
