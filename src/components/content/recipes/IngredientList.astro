---
import type { CollectionEntry } from "astro:content";
import { getIngredientNameMap, prettifyId } from "src/lib/recipes/ingredients";
import { formatIngredientDetails } from "src/lib/recipes/format";

export interface Props {
  recipe: CollectionEntry<"recipes">;
}

const { recipe } = Astro.props;
const groups = recipe.data.ingredient_groups;
const serves = recipe.data.serves;

const nameMap = await getIngredientNameMap();
---

{groups.length > 0 && (
  <div data-controller={serves ? "servings" : undefined} data-servings-base-value={serves}>
    <h2 id="ingredients">Ingredients</h2>

    {serves && (
      <div class="not-prose flex items-center gap-2 font-sans text-sm text-ink-subtle">
        <span>Servings:</span>
        <button
          type="button"
          aria-label="Decrease servings"
          data-action="servings#decrement"
          class="flex h-6 w-6 cursor-pointer items-center justify-center rounded-md border border-rule bg-surface text-ink-muted transition-[color,border-color,transform] duration-150 ease-out-strong hover:border-ink-subtle hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link active:scale-95 motion-reduce:transform-none"
        >
          &minus;
        </button>
        <span aria-live="polite" aria-atomic="true" class="min-w-4 text-center font-semibold text-ink tabular-nums">
          <span data-servings-target="count">{serves}</span>
          <span class="sr-only"> servings</span>
        </span>
        <button
          type="button"
          aria-label="Increase servings"
          data-action="servings#increment"
          class="flex h-6 w-6 cursor-pointer items-center justify-center rounded-md border border-rule bg-surface text-ink-muted transition-[color,border-color,transform] duration-150 ease-out-strong hover:border-ink-subtle hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link active:scale-95 motion-reduce:transform-none"
        >
          +
        </button>
      </div>
    )}

    {groups.map((group) => (
      <>
        {group.group && <p>For the {group.group.toLowerCase()}:</p>}
        <ul>
          {group.ingredients.map((item) => (
            <li>
              {item.id ? (
                <>
                  {nameMap.get(item.id.id) ?? prettifyId(item.id.id)}
                  {(item.quantity !== undefined || item.note) && (
                    <span
                      {...(item.quantity !== undefined && {
                        "data-servings-target": "quantity",
                        "data-quantity": item.quantity,
                        "data-unit": item.unit,
                        "data-note": item.note,
                      })}
                    >
                      {` ${formatIngredientDetails(item.quantity, item.unit, item.note)}`}
                    </span>
                  )}
                </>
              ) : (
                item.note
              )}
            </li>
          ))}
        </ul>
      </>
    ))}
  </div>
)}
