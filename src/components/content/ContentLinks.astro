---
import Link from "@components/ui/Link.astro";
import LinkList from "@components/ui/LinkList.astro";
import MobileCollapsible from "@components/ui/MobileCollapsible.astro";
import { getEntries, buildUrl } from "src/garden";
import type { EntryLink as LinkType, ZendoCollectionId } from "src/garden";

interface Props {
  outboundLinks: LinkType[];
  inboundLinks: LinkType[];
}

const { outboundLinks, inboundLinks } = Astro.props;

// Longer lists show this many entries, with the rest behind a disclosure.
const VISIBLE_LINKS = 6;

const deduplicateLinks = (links: LinkType[]): LinkType[] => {
  const seen = new Set<string>();
  return links.filter((link) => {
    const key = `${link.type}-${link.slug}`;
    if (seen.has(key)) return false;
    seen.add(key);
    return true;
  });
};

const getLinkTitle = async (link: LinkType): Promise<string> => {
  const entries = await getEntries([link.type as ZendoCollectionId]);
  return entries.find((e) => e.id === link.slug)?.data.title || link.slug;
};

const toItems = (links: LinkType[]) =>
  Promise.all(
    deduplicateLinks(links).map(async (link) => ({
      href: buildUrl({ type: link.type, slug: link.slug }),
      title: await getLinkTitle(link),
    }))
  );

// Empty lists are left out entirely rather than shown as "Nothing yet".
const groups = [
  { label: "Links to", items: await toItems(outboundLinks) },
  { label: "Linked from", items: await toItems(inboundLinks) },
].filter((group) => group.items.length > 0);
---

{groups.length > 0 && (
  <div class="space-y-4" data-sidebar-part="links">
    {groups.map(({ label, items }) => (
      <MobileCollapsible label={label}>
        <LinkList>
          {items.slice(0, VISIBLE_LINKS).map((item) => (
            <li>
              <Link class="font-sans [overflow-wrap:anywhere]" href={item.href} variant="muted">
                {item.title}
              </Link>
            </li>
          ))}
        </LinkList>

        {items.length > VISIBLE_LINKS && (
          <details class="group/more">
            <summary
              class:list={[
                "mt-1 w-fit cursor-pointer list-none rounded-sm font-sans text-sm text-ink-muted",
                "transition-colors duration-150 ease-out-strong hover:text-link group-open/more:hidden",
                "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link",
                "[&::-webkit-details-marker]:hidden",
              ]}
            >
              Show all ({items.length})
            </summary>

            <LinkList class="mt-1 space-y-1">
              {items.slice(VISIBLE_LINKS).map((item) => (
                <li>
                  <Link class="font-sans [overflow-wrap:anywhere]" href={item.href} variant="muted">
                    {item.title}
                  </Link>
                </li>
              ))}
            </LinkList>
          </details>
        )}
      </MobileCollapsible>
    ))}
  </div>
)}
