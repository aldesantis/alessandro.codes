---
import type { ZendoCollectionEntry } from "src/garden";
import EssayCard from "@components/content/essays/EssayCard.astro";
import BookCard from "@components/content/books/BookCard.astro";
import NoteCard from "@components/content/notes/NoteCard.astro";
import TopicCard from "@components/content/topics/TopicCard.astro";
import TalkCard from "@components/content/talks/TalkCard.astro";
import { type CollectionEntry } from "astro:content";
import RecipeCard from "@components/content/recipes/RecipeCard.astro";

interface Props {
  content: ZendoCollectionEntry;
  headingLevel?: 2 | 3;
}

const { content, headingLevel } = Astro.props;
---

{(() => {
  switch (content.collection) {
    case "essays":
      return <EssayCard essay={content as CollectionEntry<"essays">} headingLevel={headingLevel} />;
    case "books":
      return <BookCard book={content as CollectionEntry<"books">} headingLevel={headingLevel} />;
    case "notes":
      return <NoteCard note={content as CollectionEntry<"notes">} headingLevel={headingLevel} />;
    case "topics":
      return <TopicCard topic={content as CollectionEntry<"topics">} headingLevel={headingLevel} />;
    case "talks":
      return <TalkCard talk={content as CollectionEntry<"talks">} headingLevel={headingLevel} />;
    case "recipes":
      return <RecipeCard recipe={content as CollectionEntry<"recipes">} headingLevel={headingLevel} />;
    default:
      return null;
  }
})()}
