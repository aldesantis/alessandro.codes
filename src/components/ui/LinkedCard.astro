---
import type { ComponentProps } from "astro/types";
import Card from "@components/ui/Card.astro";
import { isInternalUrl } from "src/lib/utils/url";

type Props = ComponentProps<typeof Card> & {
  href: string;
  target?: string;
};

const { href, target, ...props } = Astro.props;
const isInternal = isInternalUrl(href);
---

<a
  href={href}
  target={target ?? (isInternal ? "_self" : "_blank")}
  rel={isInternal ? undefined : "noopener noreferrer"}
  class:list={[
    "group block rounded-lg",
    "transition-transform duration-200 ease-out-strong",
    "motion-safe:hover:-translate-y-0.5 motion-safe:active:scale-[0.99] motion-reduce:transition-none",
    "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link",
  ]}
>
  <Card {...props}>
    <slot name="cover" slot="cover" />
    <div
      class="font-sans text-lg font-semibold text-ink transition-colors duration-200 ease-out-strong group-hover:text-link"
      slot="title"
    >
      <slot name="title" />
    </div>
    <slot />
  </Card>
</a>
