---
import SearchIcon from "@components/ui/icons/SearchIcon.astro";
---

<dialog
  data-controller="command-palette"
  data-command-palette-target="dialog"
  data-action="click->command-palette#handleDialogClick cancel->command-palette#handleCancel close->command-palette#handleClose keydown@document->command-palette#handleGlobalKeydown click@document->command-palette#handleDocumentClick"
  aria-labelledby="command-palette-title"
  class="m-0 h-dvh max-h-none w-screen max-w-none overflow-y-auto border-0 bg-transparent p-4 font-sans backdrop:bg-transparent sm:p-6 md:p-20"
>
  <h2 id="command-palette-title" class="sr-only">
    Search the site
  </h2>

  <template data-command-palette-target="groupTemplate">
    <div role="group">
      <div class="px-4 pt-2 pb-1 text-xs font-semibold text-ink-subtle uppercase" aria-hidden="true"></div>
    </div>
  </template>

  <template data-command-palette-target="itemTemplate">
    <a
      role="option"
      tabindex="-1"
      aria-selected="false"
      class="group block cursor-pointer px-4 py-2 select-none aria-selected:bg-orange-600 aria-selected:text-white"
    >
      <div class="flex justify-between items-center">
        <span class="item-name"></span>
        <div class="hidden sm:flex items-center gap-2">
          <span class="status-badge"></span>
          <span class="date-text text-ink-subtle group-aria-selected:text-orange-100"></span>
        </div>
      </div>
    </a>
  </template>

  <div
    data-command-palette-target="backdrop"
    aria-hidden="true"
    class="fixed inset-0 bg-stone-900/25 opacity-0 transition-opacity duration-150 ease-out-strong motion-reduce:transition-none"
  ></div>

  <div
    data-command-palette-target="panel"
    class="relative mx-auto max-w-xl divide-y divide-rule overflow-hidden rounded-lg bg-surface shadow-2xl ring-1 ring-stone-900/5 opacity-0 scale-[0.97] transition-[opacity,scale] duration-150 ease-out-strong motion-reduce:scale-100 motion-reduce:transition-opacity"
  >
    <div class="grid grid-cols-1 rounded-t-lg focus-within:ring-2 focus-within:ring-inset focus-within:ring-link/40">
      <input
        data-command-palette-target="search"
        data-action="input->command-palette#handleSearchInput keydown->command-palette#handleSearchKeydown"
        type="search"
        role="combobox"
        aria-label="Search"
        aria-controls="command-palette-results"
        aria-expanded="false"
        aria-autocomplete="list"
        autofocus
        class="col-start-1 row-start-1 h-12 w-full bg-transparent pr-4 pl-11 text-base text-ink outline-none placeholder:text-ink-subtle sm:text-sm"
        placeholder="Search essays, notes, and more…"
        autocomplete="off"
      />
      <SearchIcon />
    </div>

    <div
      id="command-palette-results"
      role="listbox"
      aria-label="Search results"
      data-command-palette-target="results"
      data-action="click->command-palette#handleResultClick mouseover->command-palette#handleResultHover"
      class="max-h-72 scroll-py-2 overflow-y-auto py-2 text-sm text-ink hidden"
    ></div>

    <div
      data-command-palette-target="status"
      role="status"
      aria-live="polite"
      class="px-4 py-3 text-sm text-ink-subtle empty:hidden"
    ></div>
  </div>
</dialog>
