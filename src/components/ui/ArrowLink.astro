---
import type { ComponentProps } from "astro/types";
import Link from "@components/ui/Link.astro";

interface Props extends ComponentProps<typeof Link> {
  arrowDirection: "left" | "right";
}

const { arrowDirection, class: originalClass, ...props } = Astro.props;
---

<Link {...props} class:list={["group", originalClass]}>
  {arrowDirection === "left" ? (
    <span class="inline-flex items-center gap-1.5">
      <span
        aria-hidden="true"
        class="transition-transform duration-150 ease-out-strong group-hover:-translate-x-0.5 motion-reduce:translate-none"
      >
        ←
      </span>
      <slot />
    </span>
  ) : (
    <span class="inline-flex items-center">
      <slot />
      <span
        aria-hidden="true"
        class="ml-2 opacity-0 transition-[opacity,translate] duration-150 ease-out-strong -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 group-focus-visible:opacity-100 group-focus-visible:translate-x-0 motion-reduce:translate-none"
      >
        →
      </span>
    </span>
  )}
</Link>
