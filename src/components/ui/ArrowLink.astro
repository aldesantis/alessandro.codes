---
import type { ComponentProps } from "astro/types";
import Link from "@components/ui/Link.astro";

interface Props extends ComponentProps<typeof Link> {
  arrowDirection: "left" | "right";
}

const { arrowDirection, class: originalClass, ...props } = Astro.props;
---

<Link {...props} class:list={["group", originalClass]}>
  <span
    class:list={[
      "inline-flex items-center transition-transform duration-150 ease-out-strong motion-reduce:translate-none",
      arrowDirection === "left" ? "-translate-x-1 group-hover:translate-x-0" : "translate-x-0",
    ]}
  >
    {arrowDirection === "left" && (
      <span
        aria-hidden="true"
        class="mr-2 opacity-0 transition-opacity duration-150 ease-out-strong group-hover:opacity-100 group-focus-visible:opacity-100"
      >
        ←
      </span>
    )}

    <slot />

    {arrowDirection === "right" && (
      <span
        aria-hidden="true"
        class="ml-2 opacity-0 transition-[opacity,translate] duration-150 ease-out-strong -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 group-focus-visible:opacity-100 group-focus-visible:translate-x-0 motion-reduce:translate-none"
      >
        →
      </span>
    )}
  </span>
</Link>
