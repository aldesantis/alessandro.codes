---
import ChevronDownIcon from "@components/ui/icons/ChevronDownIcon.astro";

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<details class:list={["collapsible group", className]}>
  <summary
    class:list={[
      "flex w-full cursor-pointer list-none items-center justify-between border-b border-rule py-2 text-ink",
      "transition-colors duration-200 ease-out-strong hover:text-ink-muted",
      "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link",
      "[&::-webkit-details-marker]:hidden",
    ]}
  >
    <span class="font-sans text-base font-medium">{label}</span>
    <ChevronDownIcon class="ease-out-strong group-open:rotate-180 motion-reduce:transition-none" />
  </summary>

  <div class="py-2">
    <slot />
  </div>
</details>

<style>
  /*
   * Animate the native disclosure: interpolate-size lets block-size transition
   * to `auto`, and ::details-content is the slot that holds everything after
   * the summary. Browsers without support simply open and close instantly.
   */
  .collapsible {
    interpolate-size: allow-keywords;
  }

  .collapsible::details-content {
    block-size: 0;
    opacity: 0;
    overflow: clip;
    transition:
      block-size 220ms var(--ease-out-strong),
      opacity 220ms var(--ease-out-strong),
      content-visibility 220ms allow-discrete;
  }

  .collapsible[open]::details-content {
    block-size: auto;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .collapsible::details-content {
      transition: none;
    }
  }
</style>
