---
import ChevronDownIcon from "@components/ui/icons/ChevronDownIcon.astro";
import Link from "@components/ui/Link.astro";

interface Props {
  label: string;
  href?: string;
  active?: boolean;
}

const { label, href = "#", active = false } = Astro.props;

const slug = label
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/^-|-$/g, "");
const menuId = `dropdown-${slug}-${Math.random().toString(36).slice(2, 8)}`;
---

<div data-controller="dropdown" class="relative inline-block text-left">
  <div class="flex items-center gap-1">
    <Link href={href} variant="secondary" active={active}>
      {label}
    </Link>
    <button
      type="button"
      data-dropdown-target="button"
      data-action="click->dropdown#toggle"
      class:list={[
        "dropdown-button cursor-pointer rounded-md p-1 motion-safe:hover:scale-110 motion-safe:active:scale-[0.97] transition-[color,scale] duration-150 ease-out-strong",
        "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link",
        active ? "text-orange-700" : "hover:text-orange-400",
      ]}
      aria-label={`${label} menu`}
      aria-haspopup="true"
      aria-expanded="false"
      aria-controls={menuId}
    >
      <ChevronDownIcon />
    </button>
  </div>

  <div
    id={menuId}
    data-dropdown-target="menu"
    class="dropdown-menu absolute right-0 z-10 mt-2 min-w-32 origin-top-right rounded-lg border border-rule bg-surface shadow-pop hidden opacity-0 scale-95 transition-[opacity,scale] duration-150 ease-out-strong motion-reduce:scale-100 motion-reduce:transition-opacity"
  >
    <div class="py-1">
      <slot />
    </div>
  </div>
</div>
