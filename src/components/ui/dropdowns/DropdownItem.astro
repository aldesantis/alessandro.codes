---
import Link from "src/components/ui/Link.astro";

interface Props {
  href: string;
  active?: boolean;
}

const { href, active = false } = Astro.props;
---

<Link
  href={href}
  variant="secondary"
  active={active}
  class="mx-1 block rounded-md px-3 py-2 text-sm hover:bg-paper focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-link"
>
  <slot />
</Link>
