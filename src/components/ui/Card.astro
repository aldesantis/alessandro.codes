---
interface Props {
  class?: string;
}

const { class: originalClass } = Astro.props;
---

<div class:list={["flex flex-col overflow-hidden rounded-lg border border-rule bg-surface", originalClass]}>
  <div class="w-full">
    <slot name="cover" />
  </div>

  <div class="p-4">
    <slot name="title" />
    <slot />
  </div>
</div>
