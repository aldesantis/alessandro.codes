---
import type { HTMLAttributes } from "astro/types";
import { isInternalUrl } from "src/lib/utils/url";

export interface Props extends HTMLAttributes<"a"> {
  variant?: "primary" | "secondary" | "muted";
  active?: boolean;
}

const { class: originalClass, variant = "primary", active, ...props } = Astro.props;

const target = isInternalUrl(String(props.href)) ? "_self" : "_blank";

const classList = [
  "transition-colors duration-150 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-link focus-visible:rounded-sm",

  {
    "text-link hover:text-link-hover": !active && variant === "primary",
    "hover:text-link": !active && variant === "secondary",
    "text-ink-subtle hover:text-link": !active && variant === "muted",
    "text-link": active,
  },

  originalClass,
];

// Keep this on one line: with compressHTML, a newline around the slot renders
// as a space inside the link (e.g. before trailing punctuation).
---

<a target={target} {...props} class:list={classList}><slot /></a>
