---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArrowLink from "@components/ui/ArrowLink.astro";
import RecipeIllustration from "@components/content/recipes/RecipeIllustration.astro";
import ContentSidebar from "@components/content/ContentSidebar.astro";
import ContentDetail from "@components/content/ContentDetail.astro";
import RecipeMeta from "@components/content/recipes/RecipeMeta.astro";
import IngredientList from "@components/content/recipes/IngredientList.astro";
import { getEntryDescription } from "src/lib/description";
import types from "@components/content/recipes/types.json";
import cuisines from "@components/content/recipes/cuisines.json";

export async function getStaticPaths() {
  const recipes = await getCollection("recipes");

  return recipes.map((recipe) => ({
    params: { id: recipe.id },
    props: { recipe },
  }));
}

const { recipe } = Astro.props;
const { cuisine, type, serves } = recipe.data;
const description =
  (await getEntryDescription(recipe)) ??
  `${recipe.data.title}: ${cuisines[cuisine].label} ${types[type].label.toLowerCase()}${serves ? ` for ${serves}` : ""} — ingredients and step-by-step method.`;
---

<Layout title={recipe.data.title} description={description} type="article">
  <ContentDetail entry={recipe}>
    <ArrowLink
      href="/recipes"
      arrowDirection="left"
      variant="muted"
      class="-my-2 inline-block py-2 font-sans text-sm font-semibold uppercase tracking-[0.06em]"
      slot="navigation"
    >
      Recipes
    </ArrowLink>

    <RecipeMeta content={recipe} slot="meta" />

    <IngredientList recipe={recipe} slot="pre-content" />

    <ContentSidebar entry={recipe} slot="sidebar">
      <RecipeIllustration recipe={recipe} loading="eager" class="h-auto w-full max-w-[280px] rounded lg:max-w-full" />
    </ContentSidebar>
  </ContentDetail>
</Layout>
