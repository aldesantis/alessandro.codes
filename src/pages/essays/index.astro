---
export const prerender = true;

import Hero from "@components/ui/Hero.astro";
import Layout from "@layouts/Layout.astro";
import sections from "src/data/sections.json";
import ContentGrid from "@components/content/grid/ContentGrid.astro";
import { topicFilter } from "src/lib/filters";
---

<Layout title="Essays" description={sections.essays.description}>
  <Hero>
    <span slot="heading">Essays</span>
    <span slot="subheading">{sections.essays.description}</span>
  </Hero>

  <ContentGrid
    headingLevel={2}
    searchParams={{ collections: ["essays"] }}
    itemSize="L"
    filters={[await topicFilter()]}
  />
</Layout>
