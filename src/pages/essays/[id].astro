---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import { getEntryDescription } from "src/lib/description";
import ArrowLink from "@components/ui/ArrowLink.astro";
import ContentDetail from "@components/content/ContentDetail.astro";
import EssayMeta from "@components/content/essays/EssayMeta.astro";

export async function getStaticPaths() {
  const essays = await getCollection("essays");

  return essays.map((essay) => ({
    params: { id: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const description = await getEntryDescription(essay);
---

<Layout title={essay.data.title} description={description} type="article" publishedTime={essay.data.createdAt}>
  <ContentDetail entry={essay}>
    <ArrowLink
      href="/essays"
      arrowDirection="left"
      variant="muted"
      class="-my-2 inline-block py-2 font-sans text-sm font-semibold uppercase tracking-[0.06em]"
      slot="navigation"
    >
      Essays
    </ArrowLink>

    <EssayMeta content={essay} slot="meta" />
  </ContentDetail>
</Layout>
