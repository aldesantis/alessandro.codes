---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArrowLink from "@components/ui/ArrowLink.astro";
import ContentDetail from "@components/content/ContentDetail.astro";
import EssayMeta from "@components/content/essays/EssayMeta.astro";

export async function getStaticPaths() {
  const essays = await getCollection("essays");

  return essays.map((essay) => ({
    params: { id: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
---

<Layout title={essay.data.title} type="article">
  <ContentDetail entry={essay}>
    <ArrowLink
      href="/essays"
      arrowDirection="left"
      class="font-sans text-sm font-semibold uppercase tracking-wide"
      slot="navigation"
    >
      Essays
    </ArrowLink>

    <EssayMeta content={essay} slot="meta" />
  </ContentDetail>
</Layout>
