---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArrowLink from "@components/ui/ArrowLink.astro";
import ContentDetail from "@components/content/ContentDetail.astro";
import NoteMeta from "@components/content/notes/NoteMeta.astro";

export async function getStaticPaths() {
  const notes = await getCollection("notes");

  return notes.map((note) => ({
    params: { id: note.id },
    props: { note },
  }));
}

const { note } = Astro.props;
---

<Layout title={note.data.title} type="article">
  <ContentDetail entry={note}>
    <ArrowLink
      href="/notes"
      arrowDirection="left"
      class="font-sans text-sm font-semibold uppercase tracking-wide"
      slot="navigation"
    >
      Notes
    </ArrowLink>

    <NoteMeta content={note} slot="meta" />
  </ContentDetail>
</Layout>
