---
export const prerender = true;

import Hero from "@components/ui/Hero.astro";
import Layout from "@layouts/Layout.astro";
import sections from "src/data/sections.json";
import { topicFilter } from "src/lib/filters";
import ContentGrid from "@components/content/grid/ContentGrid.astro";
---

<Layout title="Books" description={sections.books.description}>
  <Hero>
    <span slot="heading">Books</span>
    <span slot="subheading">{sections.books.description}</span>
  </Hero>

  <ContentGrid
    headingLevel={2}
    searchParams={{ collections: ["books"] }}
    itemSize="S"
    filters={[await topicFilter()]}
  />
</Layout>
