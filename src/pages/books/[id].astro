---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import ArrowLink from "@components/ui/ArrowLink.astro";
import BookCover from "@components/content/books/BookCover.astro";
import ContentSidebar from "@components/content/ContentSidebar.astro";
import ContentDetail from "@components/content/ContentDetail.astro";
import BookMeta from "@components/content/books/BookMeta.astro";

export async function getStaticPaths() {
  const books = await getCollection("books");

  return books.map((book) => ({
    params: { id: book.id },
    props: { book },
  }));
}

const { book } = Astro.props;
---

<Layout title={book.data.title} type="article">
  <ContentDetail entry={book}>
    <ArrowLink
      href="/books"
      arrowDirection="left"
      variant="muted"
      class="-my-2 inline-block py-2 font-sans text-sm font-semibold uppercase tracking-[0.06em]"
      slot="navigation"
    >
      Books
    </ArrowLink>

    <BookMeta content={book} slot="meta" />

    <ContentSidebar entry={book} slot="sidebar">
      <BookCover book={book} class="w-full max-w-[250px] lg:max-w-full h-auto aspect-[2/3] rounded mt-4 lg:mt-0" />
    </ContentSidebar>
  </ContentDetail>
</Layout>
