---
export const prerender = true;

import { getCollection } from "astro:content";
import { getEntryDescription } from "src/lib/description";
import Layout from "@layouts/Layout.astro";
import { getEntries } from "src/garden";
import type { ZendoCollectionEntry } from "src/garden";
import ArrowLink from "@components/ui/ArrowLink.astro";
import ContentDetail from "@components/content/ContentDetail.astro";

export async function getStaticPaths() {
  const nows = await getCollection("nows");

  return nows.map((now) => ({
    params: { id: now.id },
    props: { now },
  }));
}

const { now } = Astro.props;
const description = await getEntryDescription(now);

// Same eyebrow style as the back links on essays and notes.
const NAV_LINK_CLASS = "-my-2 inline-block py-2 font-sans text-sm font-semibold uppercase tracking-[0.06em]";

const allNows = await getEntries(["nows"]);
const currentIndex = allNows.findIndex((item: ZendoCollectionEntry) => item.id === now.id);
const prevNow = currentIndex < allNows.length - 1 ? allNows[currentIndex + 1] : null;
const nextNow = currentIndex > 0 ? allNows[currentIndex - 1] : null;
---

<Layout title={now.data.title} description={description} type="article">
  <ContentDetail entry={now}>
    <nav aria-label="Now updates" class="flex max-w-[36rem] justify-between gap-4" slot="navigation">
      {prevNow ? (
        <ArrowLink
          href={`/now/${prevNow.id}`}
          arrowDirection="left"
          variant="muted"
          rel="prev"
          aria-label={`Previous update: ${prevNow.data.title}`}
          class={NAV_LINK_CLASS}
        >
          {prevNow.data.title}
        </ArrowLink>
      ) : (
        <div />
      )}

      {nextNow && (
        <ArrowLink
          href={`/now/${nextNow.id}`}
          arrowDirection="right"
          variant="muted"
          rel="next"
          aria-label={`Next update: ${nextNow.data.title}`}
          class={NAV_LINK_CLASS}
        >
          {nextNow.data.title}
        </ArrowLink>
      )}
    </nav>
  </ContentDetail>
</Layout>
