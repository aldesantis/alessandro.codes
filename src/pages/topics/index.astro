---
export const prerender = true;

import Hero from "@components/ui/Hero.astro";
import Layout from "@layouts/Layout.astro";
import sections from "src/data/sections.json";
import ContentGrid from "@components/content/grid/ContentGrid.astro";
import { statusFilter } from "src/lib/filters";
---

<Layout title="Topics" description={sections.topics.description}>
  <Hero>
    <span slot="heading">Topics</span>
    <span slot="subheading">{sections.topics.description}</span>
  </Hero>

  <ContentGrid
    headingLevel={2}
    searchParams={{ collections: ["topics"] }}
    itemSize="M"
    filters={[await statusFilter()]}
  />
</Layout>
