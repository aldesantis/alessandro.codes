---
export const prerender = true;

import Hero from "@components/ui/Hero.astro";
import Layout from "@layouts/Layout.astro";
import sections from "src/data/sections.json";
import ContentGrid from "@components/content/grid/ContentGrid.astro";
import { topicFilter } from "src/lib/filters";
---

<Layout title="Talks" description={sections.talks.description}>
  <Hero>
    <span slot="heading">Talks</span>
    <span slot="subheading">{sections.talks.description}</span>
  </Hero>

  <ContentGrid searchParams={{ collections: ["talks"] }} itemSize="L" filters={[await topicFilter()]} />
</Layout>
