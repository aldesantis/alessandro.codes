---
export const prerender = true;

import Layout from "@layouts/Layout.astro";
import Prose from "@components/ui/Prose.astro";
import Toc from "@components/ui/Toc.astro";
import { getMdxComponents } from "src/lib/rendering";
import SidebarLayout from "@layouts/SidebarLayout.astro";

import { Content, getHeadings } from "src/content/colophon.mdx";
---

<Layout title="Colophon">
  <SidebarLayout>
    <Fragment slot="title"> Colophon </Fragment>

    <Toc headings={getHeadings()} minHeadings={2} slot="sidebar" />

    <Prose>
      <Content components={getMdxComponents()} />
    </Prose>
  </SidebarLayout>
</Layout>
