---
// The sidebar is rendered once and rearranged with CSS: on desktop it's a
// sticky panel beside the article; below lg it dissolves (display: contents)
// and its parts order themselves around the article (cover and table of
// contents above, link lists below).
//
// On desktop, a sidebar taller than the viewport scrolls inside the panel. Its
// content fades at the top once scrolled and at the bottom until the end, so
// the cut-off edges read as "more here". The fade is driven by the scroll
// position; when nothing overflows, both fades stay at 0.
const sidebar = Astro.slots.has("sidebar") ? (await Astro.slots.render("sidebar")).trim() : "";
---

<div class="sidebar-layout flex flex-col lg:grid lg:grid-cols-12 lg:grid-rows-[auto_1fr] lg:gap-x-8">
  <div class="order-1 mb-4 min-w-0 lg:col-span-8 lg:row-start-1">
    <slot name="navigation" />

    <h1 class="font-serif font-semibold tracking-tight text-[clamp(1.75rem,1rem+3vw,3rem)] leading-[1.15] text-balance [overflow-wrap:anywhere] mt-2 mb-1">
      <slot name="title" />
    </h1>

    <div class="mb-2">
      <slot name="meta" />
    </div>
  </div>

  {sidebar && (
    <aside
      class:list={[
        "sidebar-layout-aside max-lg:contents",
        "lg:col-span-4 lg:col-start-9 lg:row-span-2 lg:row-start-1 lg:flex lg:flex-col lg:self-start",
        "lg:sticky lg:top-4 lg:max-h-[calc(100dvh-2rem)] lg:overflow-hidden",
        "lg:rounded-lg lg:border lg:border-rule lg:bg-white",
      ]}
    >
      <div
        class:list={[
          "max-lg:contents",
          "lg:min-h-0 lg:overflow-y-auto lg:overscroll-contain lg:p-6 lg:[scrollbar-width:thin]",
          "lg:[mask-image:linear-gradient(to_bottom,transparent,#000_var(--sidebar-fade-top),#000_calc(100%-var(--sidebar-fade-bottom)),transparent)]",
          "lg:supports-[animation-timeline:scroll()]:animate-sidebar-fade lg:supports-[animation-timeline:scroll()]:[animation-timeline:scroll(self)]",
        ]}
        data-sidebar-scroll
      >
        <Fragment set:html={sidebar} />
      </div>
    </aside>
  )}

  <div class="order-4 min-w-0 lg:col-span-8 lg:row-start-2">
    <slot />
  </div>
</div>
